@model SessaoFormViewModel
@{
    ViewData["Title"] = Model.EhNova ? "Nova sessão" : "Editar sessão";
}

<h1 class="h3 fw-bold mb-3">@ViewData["Title"]</h1>

<div class="painel" style="max-width: 720px">
    @* Sem "action": o formulário é enviado para o próprio endereço (/Criar ou /Editar/5) *@
    <form method="post">
        <div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>

        <div class="row g-3">
            <div class="col-12">
                <label asp-for="FilmeId" class="form-label"></label>
                <select asp-for="FilmeId" asp-items="ViewBag.Filmes" class="form-select">
                    <option value="">— Escolha o filme —</option>
                </select>
                <span asp-validation-for="FilmeId" class="text-danger small"></span>
            </div>
            <div class="col-6">
                <label asp-for="Data" class="form-label"></label>
                <input asp-for="Data" asp-format="{0:yyyy-MM-dd}" class="form-control" />
                <span asp-validation-for="Data" class="text-danger small"></span>
            </div>
            <div class="col-6">
                <label asp-for="Hora" class="form-label"></label>
                <input asp-for="Hora" asp-format="{0:HH:mm}" class="form-control" />
                <span asp-validation-for="Hora" class="text-danger small"></span>
            </div>
            <div class="col-6">
                <label for="Preco" class="form-label">Preço do bilhete (€)</label>
                <input id="Preco" name="Preco" type="number" step="0.01" min="0.01" class="form-control"
                       value="@(Model.Preco?.ToString("0.00", CultureInfo.InvariantCulture))" />
                <span asp-validation-for="Preco" class="text-danger small"></span>
            </div>
            <div class="col-6">
                <label asp-for="Lotacao" class="form-label"></label>
                <input asp-for="Lotacao" type="number" min="1" max="1000" class="form-control" />
                <div class="form-text">Número de lugares da sala = número de bilhetes à venda.</div>
                <span asp-validation-for="Lotacao" class="text-danger small"></span>
            </div>
        </div>

        <div class="d-flex gap-2 mt-4">
            <button type="submit" class="btn btn-cinema"><i class="bi bi-check-lg"></i> Guardar</button>
            <a asp-action="Index" class="btn btn-outline-secondary">Cancelar</a>
        </div>
    </form>
</div>
