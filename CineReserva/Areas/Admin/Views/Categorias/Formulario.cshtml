@model Categoria
@{
    var nova = Model.Id == 0;
    ViewData["Title"] = nova ? "Nova categoria" : "Editar categoria";
}

<h1 class="h3 fw-bold mb-3">@ViewData["Title"]</h1>

<div class="painel" style="max-width: 520px">
    @* Sem "action": o formulário é enviado para o próprio endereço (/Criar ou /Editar/5) *@
    <form method="post">
        <div class="mb-3">
            <label asp-for="Nome" class="form-label">Nome</label>
            <input asp-for="Nome" class="form-control" autofocus />
            <span asp-validation-for="Nome" class="text-danger small"></span>
        </div>
        <div class="d-flex gap-2">
            <button type="submit" class="btn btn-cinema"><i class="bi bi-check-lg"></i> Guardar</button>
            <a asp-action="Index" class="btn btn-outline-secondary">Cancelar</a>
        </div>
    </form>
</div>
