@model FilmeFormViewModel
@{
    ViewData["Title"] = Model.EhNovo ? "Adicionar filme" : "Editar filme";
}

<h1 class="h3 fw-bold mb-3">@ViewData["Title"]</h1>

@* enctype="multipart/form-data" é obrigatório para enviar o ficheiro do cartaz *@
@* Sem "action": o formulário é enviado para o próprio endereço (/Criar ou /Editar/5) *@
<form method="post" enctype="multipart/form-data">

    <div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>

    <div class="row g-4">
        <!-- Coluna do cartaz -->
        <div class="col-12 col-lg-3">
            <div class="painel text-center">
                <label class="form-label d-block">Cartaz</label>
                <img id="preVisualizacao" src="@(Model.CartazAtual ?? "/imagens/sem-cartaz.svg")" alt="Pré-visualização do cartaz" class="pre-visualizacao mb-3" />

                @* O input de ficheiro está escondido; o botão é o <label> que o abre *@
                <input asp-for="FicheiroCartaz" type="file" accept="image/*" class="d-none" />
                <label for="FicheiroCartaz" class="btn btn-dourado w-100"><i class="bi bi-image"></i> Escolher imagem</label>
                <div id="nomeFicheiro" class="small text-secondary mt-2">
                    @(Model.EhNovo ? "Nenhuma imagem escolhida" : "Deixe como está para manter o cartaz atual")
                </div>
                <span asp-validation-for="FicheiroCartaz" class="text-danger small d-block"></span>
                @if (!ViewData.ModelState.IsValid && Model.FicheiroCartaz is not null)
                {
                    <div class="small text-warning mt-2">Por segurança o browser esquece a imagem quando há erros: escolha-a de novo.</div>
                }
            </div>
        </div>

        <!-- Coluna dos dados -->
        <div class="col-12 col-lg-9">
            <div class="painel mb-4">
                <h2 class="h6 text-dourado text-uppercase mb-3">Informação do filme</h2>
                <div class="row g-3">
                    <div class="col-12">
                        <label asp-for="Titulo" class="form-label"></label>
                        <input asp-for="Titulo" class="form-control" />
                        <span asp-validation-for="Titulo" class="text-danger small"></span>
                    </div>

                    <!-- Listas para SELECIONAR -->
                    <div class="col-12 col-md-4">
                        <label asp-for="Tipo" class="form-label"></label>
                        <select asp-for="Tipo" asp-items="ViewBag.Tipos" class="form-select"></select>
                    </div>
                    <div class="col-12 col-md-4">
                        <label asp-for="CategoriaId" class="form-label"></label>
                        <select asp-for="CategoriaId" asp-items="ViewBag.Categorias" class="form-select">
                            <option value="">— Escolha —</option>
                        </select>
                        <span asp-validation-for="CategoriaId" class="text-danger small"></span>
                    </div>
                    <div class="col-12 col-md-4">
                        <label asp-for="Classificacao" class="form-label"></label>
                        <select asp-for="Classificacao" asp-items="ViewBag.Classificacoes" class="form-select"></select>
                        <span asp-validation-for="Classificacao" class="text-danger small"></span>
                    </div>

                    <!-- Campos só para SÉRIES: o site.js mostra/esconde conforme o Tipo, sem recarregar a página -->
                    <div id="camposSerie" data-max-episodios="@Filme.MaxEpisodiosPorSessao" class="col-12 @(Model.Tipo == TipoConteudo.Serie ? "" : "d-none")">
                        <div class="row g-3 p-3 rounded border border-warning-subtle mx-0">
                            <div class="col-12 small text-dourado">
                                <i class="bi bi-collection-play"></i> Episódios desta sessão (máximo @Filme.MaxEpisodiosPorSessao). Um bilhete dá acesso a todos.
                            </div>
                            <div class="col-4">
                                <label asp-for="Temporada" class="form-label"></label>
                                <input asp-for="Temporada" type="number" min="1" class="form-control" data-serie />
                                <span asp-validation-for="Temporada" class="text-danger small"></span>
                            </div>
                            <div class="col-4">
                                <label asp-for="EpisodioInicial" class="form-label"></label>
                                <input asp-for="EpisodioInicial" type="number" min="1" class="form-control" data-serie />
                                <span asp-validation-for="EpisodioInicial" class="text-danger small"></span>
                            </div>
                            <div class="col-4">
                                <label asp-for="EpisodioFinal" class="form-label"></label>
                                <input asp-for="EpisodioFinal" type="number" min="1" class="form-control" data-serie />
                                <span asp-validation-for="EpisodioFinal" class="text-danger small"></span>
                            </div>
                        </div>
                    </div>

                    <!-- Campos para ESCREVER -->
                    <div class="col-12">
                        <label asp-for="Sinopse" class="form-label"></label>
                        <textarea asp-for="Sinopse" rows="5" class="form-control"></textarea>
                        <span asp-validation-for="Sinopse" class="text-danger small"></span>
                    </div>
                    <div class="col-12 col-md-4">
                        <label asp-for="Duracao" class="form-label"></label>
                        <input asp-for="Duracao" type="number" min="1" max="600" class="form-control" />
                        <span asp-validation-for="Duracao" class="text-danger small"></span>
                    </div>
                    <div class="col-12 col-md-8">
                        <label asp-for="LinkTrailer" class="form-label"></label>
                        <input asp-for="LinkTrailer" type="url" class="form-control" placeholder="https://www.youtube.com/watch?v=..." />
                        <span asp-validation-for="LinkTrailer" class="text-danger small"></span>
                    </div>
                </div>
            </div>

            @if (Model.EhNovo)
            {
                <div class="painel mb-4">
                    <h2 class="h6 text-dourado text-uppercase mb-1">Primeira sessão</h2>
                    <p class="small text-secondary">O número de bilhetes à venda é igual ao número de lugares. Pode adicionar mais sessões depois, em "Sessões".</p>
                    <div class="row g-3">
                        <div class="col-6 col-md-3">
                            <label asp-for="Data" class="form-label"></label>
                            <input asp-for="Data" asp-format="{0:yyyy-MM-dd}" class="form-control" />
                            <span asp-validation-for="Data" class="text-danger small"></span>
                        </div>
                        <div class="col-6 col-md-3">
                            <label asp-for="Hora" class="form-label"></label>
                            <input asp-for="Hora" asp-format="{0:HH:mm}" class="form-control" />
                            <span asp-validation-for="Hora" class="text-danger small"></span>
                        </div>
                        <div class="col-6 col-md-3">
                            <label for="Preco" class="form-label">Preço do bilhete (€)</label>
                            @* Escrito à mão para o valor usar sempre ponto (7.50), que é o que o browser espera *@
                            <input id="Preco" name="Preco" type="number" step="0.01" min="0.01" class="form-control"
                                   value="@(Model.Preco?.ToString("0.00", CultureInfo.InvariantCulture))" />
                            <span asp-validation-for="Preco" class="text-danger small"></span>
                        </div>
                        <div class="col-6 col-md-3">
                            <label asp-for="Lotacao" class="form-label"></label>
                            <input asp-for="Lotacao" type="number" min="1" max="1000" class="form-control" />
                            <span asp-validation-for="Lotacao" class="text-danger small"></span>
                        </div>
                    </div>
                </div>
            }

            <div class="d-flex gap-2">
                <button type="submit" class="btn btn-cinema btn-lg"><i class="bi bi-check-lg"></i> Guardar</button>
                <a asp-action="Index" class="btn btn-outline-secondary btn-lg">Cancelar</a>
            </div>
        </div>
    </div>
</form>
