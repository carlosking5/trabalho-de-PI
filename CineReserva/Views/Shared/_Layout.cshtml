@inject UserManager<Utilizador> GestorUtilizadores
@{
    var controlador = ViewContext.RouteData.Values["controller"]?.ToString();
    string Ativo(string nome) => controlador == nome ? "active" : "";
    var utilizador = User.Identity?.IsAuthenticated == true ? await GestorUtilizadores.GetUserAsync(User) : null;
}
<!DOCTYPE html>
<html lang="pt" data-bs-theme="dark">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] · CineReserva</title>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body class="d-flex flex-column min-vh-100">

    <!-- Barra no topo -->
    <nav class="navbar navbar-expand-lg navbar-cinema sticky-top">
        <div class="container">
            <a class="navbar-brand logo" asp-controller="Home" asp-action="Index">
                <i class="bi bi-film"></i> Cine<span>Reserva</span>
            </a>
            <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#menu"
                    aria-controls="menu" aria-expanded="false" aria-label="Abrir menu">
                <span class="navbar-toggler-icon"></span>
            </button>

            <div class="collapse navbar-collapse" id="menu">
                <ul class="navbar-nav me-auto">
                    <li class="nav-item"><a class="nav-link @Ativo("Home")" asp-controller="Home" asp-action="Index">Início</a></li>
                    <li class="nav-item"><a class="nav-link @Ativo("Filmes")" asp-controller="Filmes" asp-action="Index">Filmes</a></li>
                    <li class="nav-item"><a class="nav-link @Ativo("Reservas")" asp-controller="Reservas" asp-action="Index">Minhas Reservas</a></li>
                    @if (User.IsInRole(Perfis.Administrador))
                    {
                        <li class="nav-item">
                            <a class="nav-link text-dourado" asp-area="Admin" asp-controller="Painel" asp-action="Index">
                                <i class="bi bi-speedometer2"></i> Painel de administração
                            </a>
                        </li>
                    }
                </ul>

                <div class="d-flex align-items-center gap-2">
                    @if (utilizador is not null)
                    {
                        <span class="text-secondary small"><i class="bi bi-person-circle"></i> @utilizador.Nome</span>
                        <form asp-controller="Conta" asp-action="Sair" method="post" class="d-inline">
                            <button type="submit" class="btn btn-sm btn-outline-light">Sair</button>
                        </form>
                    }
                    else
                    {
                        <a class="btn btn-sm btn-outline-light" asp-controller="Conta" asp-action="Entrar">Entrar</a>
                        <a class="btn btn-sm btn-cinema" asp-controller="Conta" asp-action="CriarConta">Criar Conta</a>
                    }
                </div>
            </div>
        </div>
    </nav>

    <main class="flex-grow-1">
        @RenderBody()
    </main>

    <footer class="rodape py-4 mt-5">
        <div class="container d-flex flex-column flex-md-row justify-content-between gap-2 small">
            <span><i class="bi bi-film text-vermelho"></i> CineReserva &copy; @DateTime.Now.Year</span>
            <span class="text-secondary">Compre o bilhete e sente-se onde quiser.</span>
        </div>
    </footer>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
