@model CatalogoViewModel
@{
    ViewData["Title"] = "Filmes";
}

<div class="container py-4">
    <h1 class="titulo-seccao">Filmes e séries</h1>

    <partial name="_FiltrosCatalogo" model="Model" />

    <p class="text-secondary small mt-3 mb-2">
        @Model.Filmes.Count resultado(s)
        @if (!string.IsNullOrWhiteSpace(Model.Pesquisa) || Model.CategoriaId is not null || Model.Tipo is not null)
        {
            <a asp-action="Index" class="ms-2">Limpar filtros</a>
        }
    </p>

    @if (Model.Filmes.Count == 0)
    {
        <div class="painel text-center py-5">
            <i class="bi bi-camera-reels text-secondary" style="font-size:3rem"></i>
            <p class="mt-2 mb-0">Nenhum filme encontrado com estes filtros.</p>
        </div>
    }

    <div class="row g-3">
        @foreach (var cartao in Model.Filmes)
        {
            <partial name="_CartaoFilme" model="cartao" />
        }
    </div>
</div>
