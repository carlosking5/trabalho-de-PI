<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>CineReserva</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <!-- Base de dados: Entity Framework Core com SQLite (ficheiro cinema.db) -->
    <PackageReference Include="Microsoft.EntityFrameworkCore.Sqlite" Version="10.0.*" />
    <!-- Login e perfis (Administrador / Cliente) guardados na mesma base de dados -->
    <PackageReference Include="Microsoft.AspNetCore.Identity.EntityFrameworkCore" Version="10.0.*" />
  </ItemGroup>

</Project>
