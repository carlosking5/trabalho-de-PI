@page "/conta/registar"
@attribute [ExcludeFromInteractiveRouting]
@using System.ComponentModel.DataAnnotations
@using CineVerse.Infrastructure
@using CineVerse.Web.Identity
@using Microsoft.AspNetCore.Identity
@inject CatalogDb Database
@inject UserManager<ApplicationUser> Users
@inject SignInManager<ApplicationUser> SignIn
@inject NavigationManager Navigation

<PageTitle>Criar conta · CineVerse</PageTitle>
<main class="account-page">
    <a href="/">CineVerse</a>
    <h1>Criar conta</h1>
    @if (Input is not null)
    {
        <EditForm Model="Input" FormName="registar" OnValidSubmit="RegisterAsync">
            <DataAnnotationsValidator />
            <ValidationSummary />
            @foreach (var error in errors) { <p role="alert" class="account-error">@error</p> }
            <label for="register-email">Email</label>
            <InputText id="register-email" type="email" autocomplete="username" @bind-Value="Input.Email" />
            <label for="register-password">Palavra-passe</label>
            <p class="account-hint" id="password-hint">Usa pelo menos 10 caracteres, com maiúscula, minúscula, algarismo e símbolo.</p>
            <input id="register-password" type="password" autocomplete="new-password" aria-describedby="password-hint" name="Input.Password" required maxlength="128" />
            <label for="register-confirm">Confirmar palavra-passe</label>
            <input id="register-confirm" type="password" autocomplete="new-password" name="Input.ConfirmPassword" required maxlength="128" />
            <button class="primary" type="submit">Criar conta</button>
        </EditForm>
    }
    <p>Já tens conta? <a href="/conta/entrar">Inicia sessão</a>.</p>
</main>

@code {
    [SupplyParameterFromForm] private FormInput? Input { get; set; }
    private IEnumerable<string> errors = [];

    protected override void OnInitialized() => Input ??= new();

    private async Task RegisterAsync()
    {
        var user = Accounts.NewUser(Input!.Email);
        await using var transaction = await Database.Database.BeginTransactionAsync();
        var result = await Users.CreateAsync(user, Input.Password);
        if (result.Succeeded) result = await Users.AddToRoleAsync(user, Accounts.Member);
        if (!result.Succeeded)
        {
            errors = result.Errors.Select(error => error.Description).ToArray();
            return;
        }

        await transaction.CommitAsync();
        await SignIn.SignInAsync(user, isPersistent: false);
        Navigation.NavigateTo("/conta");
    }

    private sealed class FormInput
    {
        [Required(ErrorMessage = "Indica o email.")]
        [EmailAddress(ErrorMessage = "Indica um email válido.")]
        [StringLength(256, ErrorMessage = "O email pode ter até 256 caracteres.")]
        public string Email { get; set; } = "";

        [Required(ErrorMessage = "Indica a palavra-passe.")]
        [StringLength(128, MinimumLength = 10, ErrorMessage = "A palavra-passe deve ter entre 10 e 128 caracteres.")]
        public string Password { get; set; } = "";

        [Required(ErrorMessage = "Confirma a palavra-passe.")]
        [Compare(nameof(Password), ErrorMessage = "As palavras-passe devem coincidir.")]
        public string ConfirmPassword { get; set; } = "";
    }
}
