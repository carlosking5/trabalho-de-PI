@page "/conta/entrar"
@attribute [ExcludeFromInteractiveRouting]
@using System.ComponentModel.DataAnnotations
@using CineVerse.Infrastructure
@using Microsoft.AspNetCore.Identity
@inject UserManager<ApplicationUser> Users
@inject SignInManager<ApplicationUser> SignIn
@inject NavigationManager Navigation

<PageTitle>Iniciar sessão · CineVerse</PageTitle>
<main class="account-page">
    <a href="/">CineVerse</a>
    <h1>Iniciar sessão</h1>
    @if (Fields is not null)
    {
        <EditForm Model="Fields" FormName="entrar" OnValidSubmit="LoginAsync">
            <DataAnnotationsValidator />
            <ValidationSummary />
            @if (error is not null) { <p role="alert" class="account-error">@error</p> }
            <label for="login-email">Email</label>
            <InputText id="login-email" type="email" autocomplete="username" @bind-Value="Fields.Email" />
            <label for="login-password">Palavra-passe</label>
            <input id="login-password" type="password" autocomplete="current-password" name="Fields.Password" required maxlength="128" />
            <label class="remember"><InputCheckbox @bind-Value="Fields.Remember" /> Manter sessão iniciada</label>
            <button class="primary" type="submit">Entrar</button>
        </EditForm>
    }
    <p>Ainda não tens conta? <a href="/conta/registar">Cria uma conta</a>.</p>
</main>

@code {
    [SupplyParameterFromForm] private FormInput? Fields { get; set; }
    [SupplyParameterFromQuery(Name = "ReturnUrl")] private string? ReturnUrl { get; set; }
    private string? error;

    protected override void OnInitialized() => Fields ??= new();

    private async Task LoginAsync()
    {
        var user = await Users.FindByEmailAsync(Fields!.Email.Trim());
        var result = user is null ? SignInResult.Failed :
            await SignIn.PasswordSignInAsync(user, Fields.Password, Fields.Remember, lockoutOnFailure: true);
        if (result.Succeeded)
            Navigation.NavigateTo(LocalReturnUrl());
        else
            error = "Não foi possível iniciar sessão. Verifica os dados ou tenta novamente mais tarde.";
    }

    private string LocalReturnUrl() => ReturnUrl is { Length: > 0 } url && url[0] == '/'
        && (url.Length == 1 || url[1] is not ('/' or '\\')) && !url.Any(char.IsControl) ? url : "/";

    private sealed class FormInput
    {
        [Required(ErrorMessage = "Indica o email.")]
        [EmailAddress(ErrorMessage = "Indica um email válido.")]
        [StringLength(256, ErrorMessage = "O email pode ter até 256 caracteres.")]
        public string Email { get; set; } = "";

        [Required(ErrorMessage = "Indica a palavra-passe.")]
        [StringLength(128, ErrorMessage = "A palavra-passe pode ter até 128 caracteres.")]
        public string Password { get; set; } = "";

        public bool Remember { get; set; }
    }
}
