@page "/conta"
@attribute [Authorize]
@attribute [ExcludeFromInteractiveRouting]
@using CineVerse.Infrastructure
@using CineVerse.Web.Identity
@using Microsoft.AspNetCore.Identity
@inject SignInManager<ApplicationUser> SignIn
@inject NavigationManager Navigation

<PageTitle>A minha conta · CineVerse</PageTitle>
<main class="account-page">
    <a href="/">CineVerse</a>
    <h1>A minha conta</h1>
    <AuthorizeView>
        <Authorized>
            <p>@context.User.FindFirst(System.Security.Claims.ClaimTypes.Email)?.Value</p>
        </Authorized>
    </AuthorizeView>
    <AuthorizeView Roles="@Accounts.Admin">
        <Authorized><p><a href="/administracao">Área de administração</a></p></Authorized>
    </AuthorizeView>
    <EditForm Model="logout" FormName="sair" OnSubmit="LogoutAsync">
        <button class="primary" type="submit">Terminar sessão</button>
    </EditForm>
</main>

@code {
    private readonly object logout = new();

    private async Task LogoutAsync()
    {
        await SignIn.SignOutAsync();
        Navigation.NavigateTo("/");
    }
}
