@page "/"
@using CineVerse.Application
@using CineVerse.Domain
@inject ICatalog Catalog

<PageTitle>CineVerse · Cinema, séries e animes</PageTitle>

<div class="dashboard @(light ? "light" : "")">
    <aside class="sidebar">
        <a class="brand" href="/" aria-label="CineVerse, início"><span class="brand-mark" aria-hidden="true">▶</span><span>Cine<strong>Verse</strong></span></a>
        <button class="mobile-menu icon-button" aria-expanded="@menuOpen" aria-label="Menu" @onclick="() => menuOpen = !menuOpen">☰</button>
        <div class="sidebar-content @(menuOpen ? "open" : "")">
            <nav aria-label="Menu principal">
                <p class="nav-label">Explorar</p>
                <button class="@NavClass(null)" @onclick="() => Navigate(null)"><span aria-hidden="true">⌂</span> Início</button>
                <button class="@NavClass(ContentKind.Film)" @onclick="() => Navigate(ContentKind.Film)"><span aria-hidden="true">▣</span> Filmes</button>
                <button class="@NavClass(ContentKind.Series)" @onclick="() => Navigate(ContentKind.Series)"><span aria-hidden="true">▤</span> Séries</button>
                <button class="@NavClass(ContentKind.Anime)" @onclick="() => Navigate(ContentKind.Anime)"><span aria-hidden="true">☆</span> Animes</button>
                <button class="@(savedOnly ? "active" : "")" @onclick="ShowSaved"><span aria-hidden="true">♡</span> Favoritos</button>
            </nav>
            <div class="sidebar-footer">
                <button class="theme" @onclick="() => light = !light"><span aria-hidden="true">@(light ? "☾" : "☀")</span> @(light ? "Modo escuro" : "Modo claro")</button>
            </div>
        </div>
    </aside>

    <main class="main-content">
        <header class="tools">
            <label class="search"><span aria-hidden="true">⌕</span><input type="search" aria-label="Pesquisar no catálogo" placeholder="Pesquisar filmes, séries, animes..." @bind="query" @bind:event="oninput" /></label>
            <button class="icon-button" aria-label="Filtros" aria-expanded="@filterOpen" @onclick="() => filterOpen = !filterOpen">☷</button>
        </header>
        @if (filterOpen)
        {
            <div class="filters">
                <label>Género <select @bind="genre"><option value="">Todos</option>@foreach (var item in titles.Select(t => t.Genre).Distinct().Order()) { <option>@item</option> }</select></label>
                <label>Ano <select @bind="year"><option value="">Todos</option>@foreach (var item in titles.Select(t => t.Year).Distinct().OrderDescending()) { <option value="@item">@item</option> }</select></label>
                <label>Ordenação <select @bind="sort"><option value="">Popularidade</option><option value="score">Classificação</option><option value="year">Mais recentes</option></select></label>
            </div>
        }
        @if (IsHome && titles.Count > 0)
        {
            var featured = titles[slide];
            <section class="hero" aria-label="Em destaque">
                <img src="@ImagePath(featured)" alt="" />
                <div class="hero-copy">
                    <span class="eyebrow">Em destaque</span>
                    <h1>@featured.Name</h1>
                    <p class="hero-meta"><span class="score">★ @Score(featured)</span> <span>@featured.Year</span> <span>@featured.Genre</span></p>
                    <p class="synopsis">@featured.Synopsis</p>
                    <button class="primary" @onclick="() => selected = featured">Ver detalhes</button>
                    <button class="hero-save" aria-label="@(saved.Contains(featured.Id) ? "Remover dos favoritos" : "Adicionar aos favoritos")" aria-pressed="@saved.Contains(featured.Id)" @onclick="() => ToggleSaved(featured)">@(saved.Contains(featured.Id) ? "♥" : "♡")</button>
                </div>
                <div class="carousel">
                    <button class="icon-button" aria-label="Destaque anterior" @onclick="() => Move(-1)">‹</button>
                    <button class="icon-button" aria-label="Destaque seguinte" @onclick="() => Move(1)">›</button>
                </div>
            </section>

            <section class="catalog-section">
                <div class="section-heading"><h2>Em tendência</h2><button class="text-button" @onclick="ShowAll">Ver catálogo</button></div>
                <div class="cards trending">
                    @foreach (var item in titles.Skip(1).Take(2)) { @Card(item) }
                </div>
            </section>
            <section class="catalog-section">
                <div class="section-heading"><h2>Populares</h2><button class="text-button" @onclick="ShowAll">Ver todos</button></div>
                <div class="cards">
                    @foreach (var item in titles.Where(t => t.Id != 2 && t.Id != 3)) { @Card(item) }
                </div>
            </section>
        }
        else
        {
            <div class="section-heading results"><h1>@Heading</h1></div>
            @if (savedOnly) { <p class="muted">Os favoritos ficam disponíveis durante esta visita.</p> }
            <div class="cards result-grid">
                @foreach (var item in Results) { @Card(item) }
            </div>
            @if (!Results.Any()) { <p class="muted">Não foram encontrados títulos.</p> }
        }
    </main>

    <aside class="activity" aria-label="Atividade">
        <div class="profile"><span class="avatar" aria-hidden="true">CV</span><div><strong>Olá, cinéfilo</strong><small>Catálogo de demonstração</small></div></div>
        <section class="activity-section">
            <div class="section-heading"><h2>Séries em destaque</h2><button class="text-button" @onclick="() => Navigate(ContentKind.Series)">Ver séries</button></div>
            @foreach (var item in titles.Where(t => t.Kind == ContentKind.Series))
            {
                <button class="activity-card" @onclick="() => selected = item">
                    <img src="@ImagePath(item)" alt="" />
                    <span><strong>@item.Name</strong><small>@item.Episode</small></span>
                </button>
            }
        </section>
        <section class="activity-section">
            <div class="section-heading"><h2>Novos episódios</h2></div>
            @foreach (var item in titles.Where(t => t.Episode is not null).Reverse())
            {
                <button class="episode" @onclick="() => selected = item">
                    <img src="@ImagePath(item)" alt="" />
                    <span><strong>@item.Name</strong><small>@item.Episode</small></span>
                    <span class="score">@Score(item)</span>
                </button>
            }
        </section>
    </aside>

    @if (selected is { } details)
    {
        <div class="overlay" @onclick="() => selected = null">
            <section class="details" role="dialog" aria-modal="true" aria-labelledby="details-heading" tabindex="0"
                     @onclick:stopPropagation @onkeydown="CloseOnEscape" @ref="detailsPanel">
                <img src="@ImagePath(details)" alt="" />
                <button class="icon-button close" aria-label="Fechar detalhes" @onclick="() => selected = null">×</button>
                <div class="details-copy">
                    <span class="eyebrow">@KindName(details.Kind)</span>
                    <h2 id="details-heading">@details.Name</h2>
                    <p class="hero-meta"><span class="score">★ @Score(details)</span><span>@details.Year</span><span>@details.Genre</span><span>@details.Episode</span></p>
                    <p>@details.Synopsis</p>
                    <button class="primary" @onclick="() => ToggleSaved(details)">@(saved.Contains(details.Id) ? "Remover dos favoritos" : "Adicionar aos favoritos")</button>
                </div>
            </section>
        </div>
    }
</div>

@code {
    private IReadOnlyList<Title> titles = [];
    private readonly HashSet<int> saved = [];
    private ContentKind? kind;
    private Title? selected;
    private ElementReference detailsPanel;
    private Title? focusedTitle;
    private string query = "", genre = "", year = "", sort = "";
    private int slide;
    private bool filterOpen, menuOpen, light, all, savedOnly;

    protected override async Task OnInitializedAsync() => titles = await Catalog.ListAsync();

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (selected == focusedTitle) return;
        focusedTitle = selected;
        if (selected is not null) await detailsPanel.FocusAsync();
    }

    private bool IsHome => !all && !savedOnly && kind is null && string.IsNullOrWhiteSpace(query)
        && genre.Length == 0 && year.Length == 0 && sort.Length == 0;

    private string Heading => savedOnly ? "Favoritos" : kind is { } category ? KindName(category) :
        !string.IsNullOrWhiteSpace(query) ? "Resultados da pesquisa" : "Catálogo";

    private IEnumerable<Title> Results
    {
        get
        {
            var matches = titles.Where(t => (!savedOnly || saved.Contains(t.Id))
                && (kind is null || t.Kind == kind)
                && (genre.Length == 0 || t.Genre == genre)
                && (year.Length == 0 || t.Year.ToString() == year)
                && System.Globalization.CultureInfo.GetCultureInfo("pt-PT").CompareInfo.IndexOf(
                    t.Name, query.Trim(), System.Globalization.CompareOptions.IgnoreCase | System.Globalization.CompareOptions.IgnoreNonSpace) >= 0);
            return sort switch
            {
                "score" => matches.OrderByDescending(t => t.Score),
                "year" => matches.OrderByDescending(t => t.Year),
                _ => matches
            };
        }
    }

    private RenderFragment Card(Title item) => @<button class="title-card" @onclick="() => selected = item">
        <img src="@ImagePath(item)" alt="" loading="lazy" />
        <span class="card-score">★ @Score(item)</span>
        <span class="card-copy"><strong>@item.Name</strong><small>@item.Year · @item.Genre</small></span>
    </button>;

    private static string ImagePath(Title title) => $"images/{title.Image}";
    private static string Score(Title title) => title.Score.ToString("0.0", System.Globalization.CultureInfo.GetCultureInfo("pt-PT"));
    private static string KindName(ContentKind category) => category switch
    {
        ContentKind.Film => "Filmes",
        ContentKind.Series => "Séries",
        _ => "Animes"
    };
    private string NavClass(ContentKind? category) => !savedOnly && !all && category == kind ? "active" : "";
    private void Move(int count) => slide = (slide + count + titles.Count) % titles.Count;
    private void ToggleSaved(Title title)
    {
        if (!saved.Add(title.Id)) saved.Remove(title.Id);
    }
    private void CloseOnEscape(KeyboardEventArgs args)
    {
        if (args.Key == "Escape") selected = null;
    }
    private void Navigate(ContentKind? category)
    {
        kind = category;
        all = savedOnly = menuOpen = false;
        query = genre = year = sort = "";
    }
    private void ShowAll() { Navigate(null); all = true; }
    private void ShowSaved() { Navigate(null); savedOnly = true; }
}
