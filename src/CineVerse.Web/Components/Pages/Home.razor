@page "/"
@using CineVerse.Application
@using CineVerse.Domain
@using CineVerse.Web.Components.Shared
@inject ICatalog Catalog
@inject IJSRuntime JS
@implements IAsyncDisposable

<PageTitle>CineVerse · Cinema, séries e animes</PageTitle>

<div class="dashboard @(light ? "light" : "")">
    <aside class="sidebar">
        <a class="brand" href="/" aria-label="CineVerse, início"><span class="brand-mark"><UiIcon Name="logo" /></span><span>Cine<strong>Verse</strong></span></a>
        <button class="mobile-menu icon-button" aria-expanded="@menuOpen" aria-controls="dashboard-menu" aria-label="Menu" @onclick="() => menuOpen = !menuOpen"><UiIcon Name="menu" /></button>
        <div id="dashboard-menu" class="sidebar-content @(menuOpen ? "open" : "")">
            <nav aria-label="Menu principal">
                <p class="nav-label">Explorar</p>
                <button class="@NavClass(null)" aria-pressed="@IsHome" @onclick="() => Navigate(null)"><UiIcon Name="home" /> Início</button>
                <button class="@NavClass(ContentKind.Film)" aria-pressed="@(kind == ContentKind.Film)" @onclick="() => Navigate(ContentKind.Film)"><UiIcon Name="film" /> Filmes</button>
                <button class="@NavClass(ContentKind.Series)" aria-pressed="@(kind == ContentKind.Series)" @onclick="() => Navigate(ContentKind.Series)"><UiIcon Name="series" /> Séries</button>
                <button class="@NavClass(ContentKind.Anime)" aria-pressed="@(kind == ContentKind.Anime)" @onclick="() => Navigate(ContentKind.Anime)"><UiIcon Name="anime" /> Animes</button>
                <button class="@(savedOnly ? "active" : "")" aria-pressed="@savedOnly" @onclick="ShowSaved"><UiIcon Name="heart" /> Favoritos</button>
            </nav>
            <div class="sidebar-footer">
                <a class="support-link" href="/ajuda"><UiIcon Name="info" /> Ajuda</a>
                <a class="support-link" href="/sobre"><UiIcon Name="logo" /> Sobre nós</a>
                <button class="theme" @onclick="ToggleThemeAsync"><UiIcon Name="@(light ? "moon" : "sun")" /> @(light ? "Modo escuro" : "Modo claro")</button>
            </div>
        </div>
    </aside>

    <main class="main-content">
        <header class="tools">
            <label class="search"><UiIcon Name="search" /><input type="search" aria-label="Pesquisar no catálogo" placeholder="Pesquisar filmes, séries, animes…" @bind="query" @bind:event="oninput" /></label>
            <button class="icon-button filter-button" aria-label="Filtros" aria-expanded="@filterOpen" aria-controls="catalog-filters" @onclick="() => filterOpen = !filterOpen"><UiIcon Name="filters" /></button>
        </header>
        @if (filterOpen)
        {
            <div id="catalog-filters" class="filters">
                <label>Género <select @bind="genre"><option value="">Todos</option>@foreach (var item in titles.Select(t => t.Genre).Distinct().Order()) { <option>@item</option> }</select></label>
                <label>Ano <select @bind="year"><option value="">Todos</option>@foreach (var item in titles.Select(t => t.Year).Distinct().OrderDescending()) { <option value="@item">@item</option> }</select></label>
                <label>Ordenação <select @bind="sort"><option value="">Popularidade</option><option value="score">Classificação</option><option value="year">Mais recentes</option></select></label>
                <button class="text-button" @onclick="ResetFilters">Limpar filtros</button>
            </div>
        }
        @if (IsHome && titles.Count > 0)
        {
            var featured = titles[slide];
            <section class="hero" aria-label="Em destaque" @key="featured.Id">
                <img src="@ImagePath(featured)" alt="" />
                <div class="hero-copy">
                    <span class="eyebrow">Em destaque</span>
                    <h1>@featured.Name</h1>
                    <p class="hero-meta"><span class="score">★ @Score(featured)</span> <span>@featured.Year</span> <span>@featured.Genre</span></p>
                    <p class="synopsis">@featured.Synopsis</p>
                    <div class="hero-actions">
                        <button class="primary" @onclick="() => OpenDetails(featured)">Ver detalhes</button>
                        <button class="hero-save" aria-label="@(saved.Contains(featured.Id) ? "Remover dos favoritos" : "Adicionar aos favoritos")" aria-pressed="@saved.Contains(featured.Id)" @onclick="() => ToggleSaved(featured)"><UiIcon Name="heart" /></button>
                    </div>
                </div>
                @if (titles.Count > 1)
                {
                    <div class="carousel">
                        <button class="icon-button" aria-label="Destaque anterior" @onclick="() => Move(-1)"><UiIcon Name="previous" /></button>
                        <button class="icon-button" aria-label="Destaque seguinte" @onclick="() => Move(1)"><UiIcon Name="next" /></button>
                    </div>
                }
            </section>

            <section class="catalog-section">
                <div class="section-heading"><h2>Em tendência</h2><button class="text-button" @onclick="ShowAll">Ver catálogo</button></div>
                <div class="cards trending">
                    @foreach (var item in titles.Take(3).Where(t => t.Id != featured.Id).Take(2)) { @Card(item) }
                </div>
            </section>
            <section class="catalog-section">
                <div class="section-heading"><h2>Mais populares</h2><button class="text-button" @onclick="ShowAll">Ver todos</button></div>
                <div class="cards">
                    @foreach (var item in titles.Take(4)) { @Card(item) }
                </div>
            </section>
            @foreach (var category in ContentSections)
            {
                var items = titles.Where(t => t.Kind == category.Kind).Take(4).ToArray();
                if (items.Length == 0) continue;
                <section class="catalog-section">
                    <div class="section-heading"><h2>@category.Heading</h2><button class="text-button" @onclick="() => Navigate(category.Kind)">Ver todos</button></div>
                    <div class="cards">
                        @foreach (var item in items) { @Card(item) }
                    </div>
                </section>
            }
        }
        else
        {
            <div class="section-heading results"><h1>@Heading</h1></div>
            @if (savedOnly) { <p class="muted">Os favoritos ficam disponíveis durante esta visita.</p> }
            var results = Results.ToArray();
            <p class="result-count" role="status">@(results.Length == 1 ? "1 título" : $"{results.Length} títulos")</p>
            @if (results.Length == 0)
            {
                <p class="muted">@(savedOnly ? "Ainda não há favoritos nesta seleção." : "Não foram encontrados títulos.")</p>
            }
            else
            {
                <div class="cards result-grid">
                    @foreach (var item in results) { @Card(item) }
                </div>
            }
        }
    </main>

    <aside class="activity" aria-label="Atividade">
        <AuthorizeView>
            <Authorized>
                <a class="profile" href="/conta"><span class="avatar" aria-hidden="true">CV</span><span><strong>A minha conta</strong><small>@context.User.FindFirst(System.Security.Claims.ClaimTypes.Email)?.Value</small></span></a>
            </Authorized>
            <NotAuthorized>
                <a class="profile" href="/conta/entrar"><span class="avatar" aria-hidden="true">CV</span><span><strong>Iniciar sessão</strong><small>Entra na tua conta CineVerse</small></span></a>
            </NotAuthorized>
        </AuthorizeView>
        <section class="activity-section">
            <div class="section-heading"><h2>Séries em destaque</h2><button class="text-button" @onclick="() => Navigate(ContentKind.Series)">Ver séries</button></div>
            @foreach (var item in titles.Where(t => t.Kind == ContentKind.Series))
            {
                <button class="activity-card" @onclick="() => OpenDetails(item)">
                    <img src="@ImagePath(item)" alt="" />
                    <span><strong>@item.Name</strong><small>@item.Episode</small></span>
                </button>
            }
        </section>
        <section class="activity-section">
            <div class="section-heading"><h2>Novos episódios</h2></div>
            @if (releases.Count == 0) { <p class="muted">Ainda não há episódios publicados.</p> }
            @foreach (var release in releases)
            {
                <button class="episode" @onclick="() => OpenDetails(release.Title, release)">
                    <img src="@($"images/{release.Image}")" alt="" loading="lazy" />
                    <span><strong>@release.Title.Name</strong><small>@EpisodeLabel(release) · @release.Name</small></span>
                    <span class="score">@Score(release.Title)</span>
                </button>
            }
        </section>
    </aside>

    <dialog class="details" aria-labelledby="details-heading" @ref="detailsPanel">
        @if (selected is { } details)
        {
                <img src="@ImagePath(details)" alt="" />
                <form method="dialog"><button type="submit" class="icon-button close" aria-label="Fechar detalhes" autofocus><UiIcon Name="close" /></button></form>
                <div class="details-copy">
                    <span class="eyebrow">@KindName(details.Kind)</span>
                    <h2 id="details-heading">@details.Name</h2>
                    <p class="hero-meta"><span class="score">★ @Score(details)</span><span>@details.Year</span><span>@details.Genre</span><span>@(selectedEpisode is { } release ? EpisodeLabel(release) : details.Episode)</span></p>
                    @if (selectedEpisode is { } episode) { <p class="episode-name">@episode.Name</p> }
                    <p>@details.Synopsis</p>
                    <button class="primary" @onclick="() => ToggleSaved(details)">@(saved.Contains(details.Id) ? "Remover dos favoritos" : "Adicionar aos favoritos")</button>
                </div>
        }
    </dialog>
</div>

@code {
    private IReadOnlyList<Title> titles = [];
    private IReadOnlyList<EpisodeRelease> releases = [];
    private static readonly (ContentKind Kind, string Heading)[] ContentSections =
    [
        (ContentKind.Film, "Filmes populares"),
        (ContentKind.Series, "Séries populares"),
        (ContentKind.Anime, "Animes populares")
    ];
    private readonly HashSet<int> saved = [];
    private ContentKind? kind;
    private Title? selected;
    private EpisodeRelease? selectedEpisode;
    private ElementReference detailsPanel;
    private IJSObjectReference? browser;
    private string query = "", genre = "", year = "", sort = "";
    private int slide;
    private bool filterOpen, menuOpen, light, all, savedOnly, openDetails;

    protected override async Task OnInitializedAsync()
    {
        titles = await Catalog.ListAsync();
        releases = await Catalog.RecentEpisodesAsync();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            browser = await JS.InvokeAsync<IJSObjectReference>("import", "./js/dashboard.js");
            light = await browser.InvokeAsync<bool>("isLightTheme");
            if (light) StateHasChanged();
        }
        if (openDetails && browser is not null)
        {
            openDetails = false;
            await browser.InvokeVoidAsync("showDetails", detailsPanel);
        }
    }

    private bool IsHome => !all && !savedOnly && kind is null && string.IsNullOrWhiteSpace(query)
        && genre.Length == 0 && year.Length == 0 && sort.Length == 0;

    private string Heading => savedOnly ? "Favoritos" : kind is { } category ? KindName(category) :
        !string.IsNullOrWhiteSpace(query) ? "Resultados da pesquisa" : "Catálogo";

    private IEnumerable<Title> Results
    {
        get
        {
            var matches = titles.Where(t => (!savedOnly || saved.Contains(t.Id))
                && (kind is null || t.Kind == kind)
                && (genre.Length == 0 || t.Genre == genre)
                && (year.Length == 0 || t.Year.ToString() == year)
                && System.Globalization.CultureInfo.GetCultureInfo("pt-PT").CompareInfo.IndexOf(
                    t.Name, query.Trim(), System.Globalization.CompareOptions.IgnoreCase | System.Globalization.CompareOptions.IgnoreNonSpace) >= 0);
            return sort switch
            {
                "score" => matches.OrderByDescending(t => t.Score),
                "year" => matches.OrderByDescending(t => t.Year),
                _ => matches
            };
        }
    }

    private RenderFragment Card(Title item) => @<button class="title-card" @onclick="() => OpenDetails(item)">
        <img src="@ImagePath(item)" alt="" loading="lazy" />
        <span class="card-score">★ @Score(item)</span>
        <span class="card-copy"><strong>@item.Name</strong><small>@item.Year · @item.Genre</small></span>
    </button>;

    private static string ImagePath(Title title) => $"images/{title.Image}";
    private static string Score(Title title) => title.Score.ToString("0.0", System.Globalization.CultureInfo.GetCultureInfo("pt-PT"));
    private static string KindName(ContentKind category) => category switch
    {
        ContentKind.Film => "Filmes",
        ContentKind.Series => "Séries",
        _ => "Animes"
    };
    private string NavClass(ContentKind? category) => (category is null ? IsHome : category == kind) ? "active" : "";
    private void Move(int count) => slide = (slide + count + titles.Count) % titles.Count;
    private void ToggleSaved(Title title)
    {
        if (!saved.Add(title.Id)) saved.Remove(title.Id);
    }
    private void OpenDetails(Title title, EpisodeRelease? episode = null)
    {
        selected = title;
        selectedEpisode = episode;
        openDetails = true;
    }
    private static string EpisodeLabel(EpisodeRelease episode) => $"T{episode.Season:00} · EP{episode.Number:00}";

    private async Task ToggleThemeAsync()
    {
        light = !light;
        if (browser is not null) await browser.InvokeVoidAsync("saveTheme", light);
    }

    public async ValueTask DisposeAsync()
    {
        if (browser is null) return;
        try { await browser.DisposeAsync(); }
        catch (JSDisconnectedException) { }
    }

    private void ResetFilters() => genre = year = sort = "";
    private void Navigate(ContentKind? category)
    {
        kind = category;
        all = savedOnly = menuOpen = false;
        query = "";
        ResetFilters();
    }
    private void ShowAll() { Navigate(null); all = true; }
    private void ShowSaved() { Navigate(null); savedOnly = true; }
}
