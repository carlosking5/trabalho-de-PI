@page "/ajuda"
@page "/sobre"
@inject NavigationManager Navigation

<PageTitle>@(IsHelp ? "Ajuda" : "Sobre nós") · CineVerse</PageTitle>
<main class="account-page support-page">
    <a href="/">Voltar ao catálogo</a>
    @if (IsHelp)
    {
        <h1>Ajuda</h1>
        <h2>Como encontro um título?</h2>
        <p>Pesquisa pelo nome ou usa os filtros de género e ano. O menu permite explorar filmes, séries e animes.</p>
        <h2>Como guardo um favorito?</h2>
        <p>Abre os detalhes de um título e seleciona «Adicionar aos favoritos». A lista fica disponível durante a visita.</p>
        <h2>Como entro na minha conta?</h2>
        <p>Abre a página <a href="/conta/entrar">Iniciar sessão</a>. Se ainda não tens conta, podes <a href="/conta/registar">criar uma</a>.</p>
    }
    else
    {
        <h1>Sobre nós</h1>
        <p>A CineVerse reúne filmes, séries e animes num catálogo em português de Portugal. Esta versão apresenta títulos fictícios e imagens criadas para o projeto.</p>
    }
</main>

@code {
    private bool IsHelp => Navigation.ToBaseRelativePath(Navigation.Uri).Split('?', '#')[0] == "ajuda";
}
